import java.util.Scanner;
public class String1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the String: ");
        String ch = sc.next();
        int a = ch.length();
        
        for (int i = 0; i < a; i++) {
            System.out.println();
        }
        
        
        
        sc.close();
    }
}